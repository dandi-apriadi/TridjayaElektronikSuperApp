# ===========================================
# TE SuperApp - Environment Configuration
# ===========================================

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DB_USER=te_admin
DB_PASSWORD=te_secret_2024
DB_NAME=te_superapp
DB_PORT=5432
DATABASE_URL=postgres://te_admin:te_secret_2024@localhost:5432/te_superapp

# ===========================================
# REDIS
# ===========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===========================================
# S3 / MINIO (File Storage)
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=te-uploads
S3_REGION=us-east-1

# ===========================================
# API SERVER
# ===========================================
API_PORT=8080
RUST_LOG=info

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
BCRYPT_COST=12

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@tridjayamanado.com
EMAIL_FROM_NAME="Tridjaya Elektronik"

# ===========================================
# WHATSAPP GATEWAY (Web Only)
# ===========================================
# Note: WhatsApp Gateway moved to Web application only
# Mobile app does NOT have WhatsApp Gateway functionality
WABLAS_API_KEY=your-wablas-api-key
WABLAS_SERVER_URL=https://wablas.com/api
WHATSAPP_MAX_MESSAGES_PER_MINUTE=20

# ===========================================
# AI / OPENAI
# ===========================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# ===========================================
# FRONTEND
# ===========================================
FLUTTER_API_BASE_URL=http://localhost:8080
WEB_API_BASE_URL=http://localhost:8080

# ===========================================
# SECURITY
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_AI_CHAT=true
