# ================================================
# Tridjaya Super App - Environment Configuration
# ================================================

# API Configuration
# Untuk Android Emulator: http://10.0.2.2:8080/api
# Untuk iOS Simulator: http://localhost:8080/api
# Untuk Device Fisik: http://192.168.x.x:8080/api (IP komputer Anda)
# Untuk Production: https://api.tridjaya.co.id/api
API_BASE_URL=http://10.0.2.2:8080/api

# Application Settings
APP_NAME=Tridjaya Super App
APP_VERSION=1.0.0

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=false

# Debug Settings (Development Only)
DEBUG_MODE=true
LOG_NETWORK_REQUESTS=true
